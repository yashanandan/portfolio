---
import '@/styles/global.css';
import ThemeToggle from '@/components/ThemeToggle.astro';

interface Props {
  title: string;
  description?: string;
  image?: string;
}

const {
  title,
  description = "Lead Software Engineer with 10 years of experience architecting and scaling distributed systems, real-time telemetry, and resilient cloud platforms.",
  image = "/og-image.png",
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://yashwanth.tech');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- Canonical URL -->
    <link rel="canonical" href={canonicalURL} />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="author" content="Yashwanth Anandan" />
    <meta name="robots" content="noindex, nofollow, noarchive, nosnippet" />
    <meta name="googlebot" content="noindex, nofollow, noarchive, nosnippet" />

    <!-- Open Graph / LinkedIn -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, Astro.url)} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={Astro.url} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={new URL(image, Astro.url)} />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />

    <!-- Theme initialization script (prevents flash of wrong theme) -->
    <script is:inline>
      const getPreferredTheme = () => {
        const stored = localStorage.getItem('theme');
        if (stored) return stored;
        return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      };

      const theme = getPreferredTheme();
      if (theme === 'dark') {
        document.documentElement.classList.add('dark');
      } else {
        document.documentElement.classList.remove('dark');
      }
    </script>
  </head>
  <body class="min-h-screen flex flex-col justify-between transition-colors duration-150">
    <!-- Navigation Header -->
    <header class="sticky top-0 z-50 backdrop-blur-md bg-white/80 dark:bg-[#090a0f]/80 border-b border-zinc-200/80 dark:border-zinc-800/70 transition-colors">
      <div class="max-w-4xl mx-auto px-6 h-14 flex items-center justify-between">
        <a href="/" class="group flex items-center gap-1.5 font-mono text-sm tracking-tight text-zinc-900 dark:text-zinc-100 hover:text-zinc-600 dark:hover:text-zinc-300 transition-colors">
          <span class="text-zinc-400 dark:text-zinc-500 font-normal">~/</span>
          <span class="font-semibold">yashwanth.tech</span>
        </a>
        <nav class="flex items-center space-x-5 text-sm font-medium text-zinc-600 dark:text-zinc-400">
          <a href="/#experience" class="hover:text-zinc-950 dark:hover:text-zinc-100 transition-colors">Experience</a>
          <a href="/#skills" class="hover:text-zinc-950 dark:hover:text-zinc-100 transition-colors">Skills</a>
          <a href="/blog" class="hover:text-zinc-950 dark:hover:text-zinc-100 transition-colors">Writing</a>
          <a
            href="/resume/Yashwanth_Anandan_Resume.pdf"
            target="_blank"
            rel="noopener noreferrer"
            class="hover:text-zinc-950 dark:hover:text-zinc-100 transition-colors inline-flex items-center gap-1"
          >
            Resume ↗
          </a>
          <a href="/#contact" class="hover:text-zinc-950 dark:hover:text-zinc-100 transition-colors">Contact</a>
          <ThemeToggle />
        </nav>
      </div>
    </header>

    <!-- Main Content -->
    <main class="flex-grow">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="border-t border-zinc-200 dark:border-zinc-800/80 bg-zinc-50/50 dark:bg-[#07080b] py-10 mt-20 transition-colors">
      <div class="max-w-4xl mx-auto px-6 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-zinc-500 dark:text-zinc-500">
        <p>© {new Date().getFullYear()} Yashwanth Anandan. Lead Software Engineer.</p>
        <div class="flex items-center space-x-4 font-mono">
          <a href="/resume/Yashwanth_Anandan_Resume.pdf" target="_blank" rel="noopener noreferrer" class="hover:text-zinc-800 dark:hover:text-zinc-300 transition-colors">Resume (PDF) ↗</a>
          <span class="text-zinc-300 dark:text-zinc-700">•</span>
          <a href="https://linkedin.com/in/yashwanth-anandan" target="_blank" rel="noopener noreferrer" class="hover:text-zinc-800 dark:hover:text-zinc-300 transition-colors">LinkedIn ↗</a>
          <span class="text-zinc-300 dark:text-zinc-700">•</span>
          <a href="mailto:yashanandan@gmail.com" class="hover:text-zinc-800 dark:hover:text-zinc-300 transition-colors">Email</a>
          <span class="text-zinc-300 dark:text-zinc-700">•</span>
          <a href="/blog" class="hover:text-zinc-800 dark:hover:text-zinc-300 transition-colors">Articles</a>
        </div>
      </div>
    </footer>
  </body>
</html>
